{
  "SessionStart": [
    {"matcher": "", "hooks": [{"type": "command", "command": "python3 \"$HOME/.claude/skills/vesta/scripts/vesta.py\" hook-inicio || true", "timeout": 10}]}
  ],
  "PostToolUse": [
    {"matcher": "Bash", "hooks": [{"type": "command", "command": "python3 \"$HOME/.claude/skills/vesta/scripts/vesta.py\" hook-adocao || true", "timeout": 10}]},
    {"matcher": "Edit|Write|NotebookEdit", "hooks": [{"type": "command", "command": "printf %s 'Seco: nao narre esta edicao. A diff ja mostra o arquivo, as linhas e o conteudo. Siga para a proxima ferramenta; so escreva se houver decisao, achado que muda o rumo, ou o resultado final.'", "timeout": 5}]}
  ],
  "Stop": [
    {"matcher": "", "hooks": [{"type": "command", "command": "python3 \"$HOME/.claude/skills/vesta/scripts/vesta.py\" hook-parada || true", "timeout": 10}]}
  ]
}
