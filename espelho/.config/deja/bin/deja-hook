#!/bin/sh
# generated by deja install — finds the deja binary at run time so an
# upgrade that moves it does not have to rewrite every agent's config.
# Safe to delete; `deja install` writes it again.
if [ -n "$DEJA_BIN" ] && [ -x "$DEJA_BIN" ]; then exec "$DEJA_BIN" "$@"; fi
for c in \
  '__HOME__/.local/bin/deja' \
  '__HOME__/bin/deja' \
  '/usr/local/bin/deja' \
  '/opt/homebrew/bin/deja' \
  '/usr/bin/deja' \
  ; do
  [ -x "$c" ] && exec "$c" "$@"
done
c=$(command -v deja 2>/dev/null) || c=""
[ -n "$c" ] && exec "$c" "$@"
exit 0
