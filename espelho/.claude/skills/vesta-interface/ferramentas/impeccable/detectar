#!/bin/sh
set -eu
dir=$(cd "$(dirname "$0")" && pwd)
bin="${IMPECCABLE_HOME:-$HOME/.impeccable}/bin/$(cat "$dir/VERSION")/impeccable"
if [ -x "$bin" ]; then export IMPECCABLE_BIN="$bin"; fi
case "${1:-}" in --version) exec "$dir/impeccable" "$@" ;; esac
# o CLI só lê exceções de .impeccable/config.json na pasta corrente: roda de uma pasta
# temporária com a config gerada de excecoes.json, e os caminhos relativos viram absolutos
for a do
  shift
  case $a in -*|/*|*://*) ;; *) if [ -e "$a" ]; then a="$PWD/$a"; fi ;; esac
  set -- "$@" "$a"
done
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
trap 'exit 1' HUP INT TERM
mkdir "$tmp/.impeccable"
python3 - "$dir/excecoes.json" "$tmp/.impeccable/config.json" <<'PY'
import json, sys
excecoes = json.load(open(sys.argv[1], encoding='utf-8'))
valores = [{'rule': e['regra'], 'value': e['valor'].lower(), 'reason': e['motivo']} for e in excecoes]
json.dump({'detector': {'ignoreRules': [], 'ignoreFiles': [], 'ignoreValues': valores}},
          open(sys.argv[2], 'w', encoding='utf-8'), ensure_ascii=False, indent=2)
PY
cd "$tmp"
s=0
"$dir/impeccable" detect "$@" || s=$?
exit $s
